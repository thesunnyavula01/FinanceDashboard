# dependencies
node_modules/
.pnp
.pnp.js

# secrets — NEVER commit these
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.*
!.env.example

# .env.production is COMMITTED on purpose, and must stay that way. It holds
# only the publishable Supabase URL and anon key, which Vite inlines into the
# browser bundle at build time. Cloudflare’s build machine has no .env, so
# ignoring this file is what made every CI build ship a login page that could
# not connect. Nothing secret goes in it.
!.env.production
!.dev.vars.example

# build output
dist/
dist-ssr/
build/
*.local

# cloudflare
.wrangler/
worker-configuration.d.ts

# supabase
supabase/.branches/
supabase/.temp/

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
