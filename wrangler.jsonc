{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker in the Cloudflare dashboard. Workers Builds derives
  // the service name from the repository, so this is "financedashboard" rather
  // than the project's own name: a mismatch makes every CI deploy print
  // "Failed to match Worker name", override this value, and offer to open a
  // pull request correcting it.
  "name": "financedashboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",

    // Unmatched routes serve index.html so React Router can handle deep links
    // like /leaderboard on a hard refresh.
    "not_found_handling": "single-page-application",

    // Without this, `not_found_handling` would swallow /api/* and return the
    // HTML shell instead of JSON. Listing the API prefix explicitly is what
    // routes those requests to the Worker; everything else is served straight
    // from the asset store and never costs a Worker invocation.
    "run_worker_first": ["/api/*"]
  },

  // Holds the nightly copy of Alpaca's tradable asset list, sharded by first
  // letter, so ticker autocomplete is a small local read.
  //
  // Despite the binding name, quotes are NOT cached here: a 20s TTL would be
  // ~234,000 writes a day against a 1,000/day free-tier ceiling, and KV has a
  // 60-second floor on expirationTtl. Prices use isolate memory plus the Cache
  // API — see worker/market/quotes.ts.
  //
  // Namespace "financedashboard-QUOTES", created 2026-08-30. The id is not a
  // secret — it names a namespace, and reaching it still requires the account's
  // credentials — so it belongs in the config rather than in the secret store.
  "kv_namespaces": [
    {
      "binding": "QUOTES",
      "id": "6d645b694a1b4555b0ea3ed17d1880ce"
    }
  ],

  "triggers": {
    "crons": [
      // The resting-order sweep: fills orders queued while the market was shut,
      // and expires day orders at the close.
      //
      // Every minute of every day, because crypto has no bell. A queued BTC
      // limit is fillable at 3am on a Sunday, and there is no honest reason to
      // make it wait for the NYSE to open. The equity window this used to be
      // ("* 13-21 * * 1-5") is now enforced per order inside the sweep, by
      // tradingWindow(), which asks the exchange calendar for a stock or an
      // option and nothing at all for a coin.
      //
      // The idle cost is one indexed query against pending_orders — the sweep
      // looks for work before it looks at the clock, so the ~1,400 ticks a day
      // that have nothing to do cost a single row count and no upstream call.
      //
      // This DOES share a minute with the nightly job at 22:15, which the old
      // schedule was arranged to avoid. That is unavoidable once the sweep runs
      // continuously, and it is harmless: scheduled() dispatches the two as
      // independent waitUntil promises that touch different tables.
      "* * * * *",

      // The nightly tick: refresh the tradable universe, then snapshot every
      // portfolio and the two benchmarks.
      //
      // 22:15 UTC is 18:15 ET in summer and 17:15 ET in winter — still the same
      // exchange date, which is what the snapshot is stamped with, but far
      // enough past the 16:00 close that the daily bars it prices the club at
      // have certainly been published. In winter the close is 21:00 UTC, so an
      // earlier slot would leave only minutes of margin. It also sits outside
      // the sweep's 13:00-21:59 window, so the two jobs never share a minute.
      //
      // The handler gates itself on whether the exchange actually held a
      // session, so a holiday costs one bar request and writes nothing.
      "15 22 * * 1-5"
    ]
  },

  "vars": {
    "APP_NAME": "FINANCE CLUB TERMINAL",
    "SUPABASE_URL": "https://vtlqkgpcfdhslqahivzf.supabase.co",
    "ALPACA_DATA_FEED": "iex",
    "QUOTE_CACHE_TTL": "20",

    // Sent as the User-Agent on every SEC EDGAR request. The SEC refuses an
    // unidentified caller with 403 rather than throttling it, and asks that the
    // address be one a person actually reads. Not a secret: being reachable is
    // the entire point of it. Replace the placeholder before Phase 10 ships.
    "SEC_CONTACT": "Finance Club Terminal - set-me@example.com"
  }

  // Secrets are NOT listed here. They come from .dev.vars locally and from
  // `wrangler secret put` in production. See DEPLOYMENT.md.
}
