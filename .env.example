# =============================================================================
# Finance Club Terminal — environment template
# =============================================================================
# Copy the PUBLIC block into `.env`  and the SECRET block into `.dev.vars`.
# Both of those files are gitignored. This file is committed and must stay empty.
#
#   .env        -> read by Vite. Anything here IS SHIPPED TO THE BROWSER.
#   .dev.vars   -> read by Wrangler for local Worker dev. Server-side only.
#   production  -> `wrangler secret put NAME` for every SECRET below.
#
# Fill-in instructions live in SETUP.md.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLIC  ->  .env   (safe in the client bundle; protected by Postgres RLS)
# -----------------------------------------------------------------------------

# Supabase > Project Settings > Data API > Project URL
VITE_SUPABASE_URL=

# Supabase > Project Settings > API Keys > anon / public
# Safe to expose: it can only do what RLS policies allow.
VITE_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# SECRET  ->  .dev.vars   (NEVER prefix these with VITE_ — that would leak them)
# -----------------------------------------------------------------------------

# Supabase > Project Settings > API Keys > service_role
# Bypasses ALL row-level security. Worker-only. Treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Project Settings > Data API > JWT Settings > JWT Secret
# Used by the Worker to verify member session tokens on every mutating request.
SUPABASE_JWT_SECRET=

# Alpaca (PAPER account) > Home > API Keys > Generate
# Primary market data: batch quotes, historical bars, market clock, asset list.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Finnhub > Dashboard > API Key
# Used ONLY for company profile -> sector classification, cached forever.
FINNHUB_API_KEY=

# Reddit > reddit.com/prefs/apps > "create app" > type: script
# F4's discussion panel, and the ONLY new credential the Research screen needs.
# Free for non-commercial use at 100 queries/min per client id — a school club
# qualifies, same as Finnhub's tier. Leave both blank and the panel says it is
# unconfigured; every other panel on the screen is unaffected.
#
# The screen's other sources need no key at all: GDELT (global press), SEC EDGAR
# (filings) and Hacker News are open endpoints, and the headlines themselves come
# off the Alpaca and Finnhub keys above.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# The code members must type to create an account. Change this to your own.
#
# This is the SEED only. It is what signup accepts until an officer sets a code
# in the admin console (F5); after that the stored one is the only code that
# works, which is what makes rotating it a rotation rather than a second door.
CLUB_INVITE_CODE=


# -----------------------------------------------------------------------------
# TUNABLES  ->  .dev.vars (optional; these are the defaults if omitted)
# -----------------------------------------------------------------------------

# Seconds a quote stays cached server-side. Drives the dashboard refresh cadence.
QUOTE_CACHE_TTL=20

# Alpaca data feed. `iex` is the free tier. `sip` requires a paid plan.
ALPACA_DATA_FEED=iex

# Sent as the User-Agent on every SEC EDGAR request. Not a secret — the SEC
# requires a real, reachable address and refuses an unidentified caller with 403.
# The committed default lives in wrangler.jsonc; override it here for local dev.
SEC_CONTACT=
