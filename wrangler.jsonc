{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-club-terminal",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",

    // Unmatched routes serve index.html so React Router can handle deep links
    // like /leaderboard on a hard refresh.
    "not_found_handling": "single-page-application",

    // Without this, `not_found_handling` would swallow /api/* and return the
    // HTML shell instead of JSON. Listing the API prefix explicitly is what
    // routes those requests to the Worker; everything else is served straight
    // from the asset store and never costs a Worker invocation.
    "run_worker_first": ["/api/*"]
  },

  // Holds the nightly copy of Alpaca's tradable asset list, sharded by first
  // letter, so ticker autocomplete is a small local read.
  //
  // Despite the binding name, quotes are NOT cached here: a 20s TTL would be
  // ~234,000 writes a day against a 1,000/day free-tier ceiling, and KV has a
  // 60-second floor on expirationTtl. Prices use isolate memory plus the Cache
  // API — see worker/market/quotes.ts.
  //
  // Create with: npx wrangler kv namespace create QUOTES
  // then paste the returned id below.
  "kv_namespaces": [
    {
      "binding": "QUOTES",
      "id": "PLACEHOLDER_RUN_WRANGLER_KV_NAMESPACE_CREATE_QUOTES"
    }
  ],

  "triggers": {
    "crons": [
      // The resting-order sweep: fills orders queued while the market was shut,
      // and expires day orders at the close. Every minute from 13:00 to 21:59
      // UTC on weekdays, which brackets 09:30-16:00 ET in both EDT (UTC-4) and
      // EST (UTC-5) without needing to know which is in force. The sweep itself
      // reads the exchange calendar and does nothing unless the market is
      // genuinely open, so the extra ticks around the edges — and on holidays —
      // cost one cached clock lookup each.
      //
      // No weekend entry, deliberately. There is no session to fill into: a
      // queue built on Sunday comes to life at Monday's open.
      "* 13-21 * * 1-5",

      // The nightly tick: refresh the tradable universe, then snapshot every
      // portfolio and the two benchmarks.
      //
      // 22:15 UTC is 18:15 ET in summer and 17:15 ET in winter — still the same
      // exchange date, which is what the snapshot is stamped with, but far
      // enough past the 16:00 close that the daily bars it prices the club at
      // have certainly been published. In winter the close is 21:00 UTC, so an
      // earlier slot would leave only minutes of margin. It also sits outside
      // the sweep's 13:00-21:59 window, so the two jobs never share a minute.
      //
      // The handler gates itself on whether the exchange actually held a
      // session, so a holiday costs one bar request and writes nothing.
      "15 22 * * 1-5"
    ]
  },

  "vars": {
    "APP_NAME": "FINANCE CLUB TERMINAL",
    "SUPABASE_URL": "https://vtlqkgpcfdhslqahivzf.supabase.co",
    "ALPACA_DATA_FEED": "iex",
    "QUOTE_CACHE_TTL": "20"
  }

  // Secrets are NOT listed here. They come from .dev.vars locally and from
  // `wrangler secret put` in production. See DEPLOYMENT.md.
}
